{
  "name": "skraft-mcp",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm --filter @agent-studio/mcp-skraft build",
    "start": "pnpm --filter @agent-studio/mcp-skraft start",
    "deployer": "pnpm --filter @agent-studio/mcp-skraft deployer",
    "commandes": "pnpm --filter @agent-studio/mcp-skraft commandes",
    "essai": "tsx scripts/essai-mcp-skraft.ts",
    "banc:revues": "tsx scripts/banc/revues-du-run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@agent-studio/core": "workspace:*",
    "@agent-studio/extension-host": "workspace:*",
    "@agent-studio/extension-packaging": "workspace:*",
    "@agent-studio/github-auth": "workspace:*",
    "@agent-studio/project-services": "workspace:*",
    "@agent-studio/runtime-claude": "workspace:*",
    "@agent-studio/runtime-copilot": "workspace:*",
    "@agent-studio/workflow": "workspace:*",
    "@agent-studio/workspace": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "^22.19.0",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
