{
  "name": "skraft-mcp",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm --filter @skraft-mcp/serveur build",
    "start": "pnpm --filter @skraft-mcp/serveur start",
    "deployer": "pnpm --filter @skraft-mcp/serveur deployer",
    "commandes": "pnpm --filter @skraft-mcp/serveur commandes",
    "essai": "tsx scripts/essai-mcp-skraft.ts",
    "banc:revues": "tsx scripts/banc/revues-du-run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@skraft-mcp/agents": "workspace:*",
    "@skraft-mcp/bac-a-sable": "workspace:*",
    "@skraft-mcp/github": "workspace:*",
    "@skraft-mcp/runtime-claude": "workspace:*",
    "@skraft-mcp/runtime-copilot": "workspace:*",
    "@skraft-mcp/workflow": "workspace:*",
    "@skraft-mcp/depot": "workspace:*",
    "@types/node": "^22.19.0",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
